# RHEL-based Build Agent
FROM registry.access.redhat.com/ubi9/ubi:latest

LABEL maintainer="cloudshell-team"
LABEL description="RHEL-based build agent for CloudShell system"

# Install basic tools (--allowerasing to replace curl-minimal with full curl)
RUN dnf install -y --allowerasing \
    curl \
    wget \
    git \
    make \
    gcc \
    gcc-c++ \
    python3 \
    python3-pip \
    nodejs \
    npm \
    && dnf clean all

# Install additional build tools
RUN npm install -g typescript ts-node

# Create agent user
RUN useradd -m -s /bin/bash agent
USER agent
WORKDIR /home/agent

# Agent healthcheck script
COPY --chown=agent:agent scripts/agent-healthcheck.sh /home/agent/
RUN chmod +x /home/agent/agent-healthcheck.sh

# Keep container running
CMD ["tail", "-f", "/dev/null"]
